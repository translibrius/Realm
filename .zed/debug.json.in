[
  {
    "label": "Debug Realm",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/build/debug/bin/Realm@EXE_SUFFIX@",
    "args": ["--project", "${ZED_WORKTREE_ROOT}/realm/"],
    "cwd": "${ZED_WORKTREE_ROOT}/build/debug/bin",
    "build": {
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
    },
  },
